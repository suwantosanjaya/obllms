generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                   String                    @id @default(cuid())
  email                String                    @unique
  name                 String
  password             String                    @default("$2a$10$xyz")
  role                 String                    @default("student")
  isActive             Boolean                   @default(true)
  approvalStatus       String                    @default("APPROVED")
  mustChangePassword   Boolean                   @default(false)
  approvedBy           String?
  approvedAt           DateTime?
  homebaseDepartmentId String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  announcements        Announcement[]
  courses              Course[]                  @relation("CourseInstructor")
  headedDepartments    Department[]              @relation("ActiveHead")
  accessRequests       DepartmentAccessRequest[]
  headHistories        DepartmentHeadHistory[]
  enrollments          Enrollment[]
  headedFaculties      Faculty[]                 @relation("ActiveDean")
  deanHistories        FacultyDeanHistory[]
  feedbacks            Feedback[]
  forumReplies         ForumReply[]
  forumThreads         ForumThread[]
  repliedTickets       HelpdeskTicket[]          @relation("TicketReplier")
  createdTickets       HelpdeskTicket[]          @relation("TicketCreator")
  studentProfile       StudentProfile?
  submissions          Submission[]
  teacherProfile       TeacherProfile?
  headedUniversities   University[]              @relation("ActiveRector")
  rectorHistories      UniversityRectorHistory[]
  homebaseDepartment   Department?               @relation("UserHomebase", fields: [homebaseDepartmentId], references: [id])
  departmentRoles      UserDepartmentRole[]
  universityRoles      UserUniversityRole[]
  departments          Department[]              @relation("UserDepartments")
}

model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  nim          String?  @unique
  angkatan     Int?
  jenisKelamin String?
  alamat       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  nidn          String?  @unique
  nip           String?  @unique
  gelarDepan    String?
  gelarBelakang String?
  isDlb         Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserDepartmentRole {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  role         String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId, role])
}

model UserUniversityRole {
  id           String     @id @default(cuid())
  userId       String
  universityId String
  role         String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, universityId, role])
}

model University {
  id              String                    @id @default(cuid())
  code            String                    @unique
  name            String
  logo            String?
  activeRectorId  String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  faculties       Faculty[]
  gradeScales     GradeScale[]
  systemSettings  SystemSetting[]
  activeRector    User?                     @relation("ActiveRector", fields: [activeRectorId], references: [id])
  rectorHistories UniversityRectorHistory[]
  userRoles       UserUniversityRole[]
}

model UniversityRectorHistory {
  id              String     @id @default(cuid())
  universityId    String
  userId          String
  startYear       Int
  endYear         Int
  isActive        Boolean    @default(true)
  appointmentDate DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  university      University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  key          String
  value        String
  id           String      @id @default(cuid())
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, key])
}

model Faculty {
  id            String               @id @default(cuid())
  code          String               @unique
  name          String
  activeDeanId  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  universityId  String?
  departments   Department[]
  activeDean    User?                @relation("ActiveDean", fields: [activeDeanId], references: [id])
  university    University?          @relation(fields: [universityId], references: [id])
  deanHistories FacultyDeanHistory[]
  subjects      Subject[]
}

model FacultyDeanHistory {
  id              String    @id @default(cuid())
  facultyId       String
  userId          String
  startYear       Int
  endYear         Int
  isActive        Boolean   @default(true)
  appointmentDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  faculty         Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  id                    String                     @id @default(cuid())
  code                  String                     @unique
  name                  String
  facultyId             String
  activeHeadId          String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  announcements         Announcement[]
  courses               Course[]
  clos                  CourseLearningOutcome[]
  curriculumYears       CurriculumYear[]
  activeHead            User?                      @relation("ActiveHead", fields: [activeHeadId], references: [id])
  faculty               Faculty                    @relation(fields: [facultyId], references: [id])
  accessRequests        DepartmentAccessRequest[]
  departmentCurriculums DepartmentCurriculum[]
  headHistories         DepartmentHeadHistory[]
  graduateProfiles      GraduateProfile[]
  visionMissions        InstitutionVisionMission[]
  plos                  ProgramLearningOutcome[]
  subjects              Subject[]
  homebaseUsers         User[]                     @relation("UserHomebase")
  userRoles             UserDepartmentRole[]
  users                 User[]                     @relation("UserDepartments")
}

model DepartmentAccessRequest {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  role         String     @default("teacher")
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id              String              @id @default(cuid())
  code            String              @unique
  title           String
  description     String?
  type            String              @default("wajib")
  scope           String              @default("department")
  credits         Int                 @default(3)
  facultyId       String?
  departmentId    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  courses         Course[]
  curriculumYears CurriculumSubject[]
  department      Department?         @relation(fields: [departmentId], references: [id])
  faculty         Faculty?            @relation(fields: [facultyId], references: [id])
  subjectClos     SubjectCLO[]
}

model Course {
  id               String          @id @default(cuid())
  subjectId        String
  departmentId     String?
  curriculumYearId String?
  semester         String          @default("Ganjil")
  academicYear     String          @default("2025/2026")
  classCode        String?         @default("Kelas Reguler")
  schedule         String?
  instructorId     String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  assessments      Assessment[]
  curriculumYear   CurriculumYear? @relation(fields: [curriculumYearId], references: [id])
  department       Department?     @relation(fields: [departmentId], references: [id])
  instructor       User            @relation("CourseInstructor", fields: [instructorId], references: [id])
  subject          Subject         @relation(fields: [subjectId], references: [id])
  config           CourseConfig?
  modules          CourseModule[]
  enrollments      Enrollment[]
  forums           ForumThread[]
}

model Enrollment {
  id                String                    @id @default(cuid())
  studentId         String
  courseId          String
  status            String                    @default("active")
  srlTarget         Int                       @default(0)
  createdAt         DateTime                  @default(now())
  course            Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student           User                      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gameProfile       GamificationProfile?
  reflections       SrlReflection[]
  courseEvaluations StudentCourseEvaluation[]
  skillAssessment   StudentSkillAssessment?

  @@unique([studentId, courseId])
}

model InstitutionVisionMission {
  id               String            @id @default(cuid())
  code             String
  description      String
  type             String            @default("vision")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  departmentId     String?
  curriculumYearId String?
  graduateProfiles GraduateProfile[]
  curriculumYear   CurriculumYear?   @relation(fields: [curriculumYearId], references: [id])
  department       Department?       @relation(fields: [departmentId], references: [id])
}

model GraduateProfile {
  id               String                    @id @default(cuid())
  code             String
  title            String
  description      String?
  visionMissionId  String?
  departmentId     String?
  curriculumYearId String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  curriculumYear   CurriculumYear?           @relation(fields: [curriculumYearId], references: [id])
  department       Department?               @relation(fields: [departmentId], references: [id])
  visionMission    InstitutionVisionMission? @relation(fields: [visionMissionId], references: [id])
  plos             ProgramLearningOutcome[]  @relation("GraduateProfileToProgramLearningOutcome")
}

model ProgramLearningOutcome {
  id               String                  @id @default(cuid())
  code             String
  description      String
  departmentId     String?
  curriculumYearId String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  curriculumYear   CurriculumYear?         @relation(fields: [curriculumYearId], references: [id])
  department       Department?             @relation(fields: [departmentId], references: [id])
  subjectClos      SubjectCLO[]
  clos             CourseLearningOutcome[] @relation("CourseLearningOutcomeToProgramLearningOutcome")
  graduateProfiles GraduateProfile[]       @relation("GraduateProfileToProgramLearningOutcome")
}

model CourseLearningOutcome {
  id                  String                   @id @default(cuid())
  departmentId        String?
  curriculumYearId    String?
  code                String
  description         String
  assessmentClos      AssessmentCLO[]
  assessmentQuestions AssessmentQuestion[]
  curriculumYear      CurriculumYear?          @relation(fields: [curriculumYearId], references: [id])
  department          Department?              @relation(fields: [departmentId], references: [id])
  modules             CourseModule[]
  moduleClos          CourseModuleCLO[]
  threads             ForumThread[]
  subjectClos         SubjectCLO[]
  submissionScores    SubmissionCLOScore[]
  plos                ProgramLearningOutcome[] @relation("CourseLearningOutcomeToProgramLearningOutcome")
}

model SubjectCLO {
  id         String                 @id @default(cuid())
  subjectId  String
  cloId      String
  ploId      String
  weight     Float                  @default(0)
  clo        CourseLearningOutcome  @relation(fields: [cloId], references: [id], onDelete: Cascade)
  plo        ProgramLearningOutcome @relation(fields: [ploId], references: [id], onDelete: Cascade)
  subject    Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  techniques SubjectCLOTechnique[]

  @@unique([subjectId, cloId, ploId])
}

model SubjectCLOTechnique {
  id           String     @id @default(cuid())
  subjectCloId String
  technique    String
  weight       Float      @default(0)
  subjectClo   SubjectCLO @relation(fields: [subjectCloId], references: [id], onDelete: Cascade)

  @@unique([subjectCloId, technique])
}

model Assessment {
  id                  String               @id @default(cuid())
  courseId            String
  title               String
  description         String?
  type                String
  format              String               @default("upload")
  isPublished         Boolean              @default(false)
  dueDate             DateTime?
  maxScore            Int                  @default(100)
  allowReview         Boolean              @default(false)
  shuffleQuestions    Boolean              @default(false)
  timeLimit           Int?
  isScorePublished    Boolean              @default(false)
  allowLateSubmission Boolean              @default(true)
  course              Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assessmentClos      AssessmentCLO[]
  questions           AssessmentQuestion[]
  submissions         Submission[]
}

model AssessmentCLO {
  id           String                @id @default(cuid())
  assessmentId String
  cloId        String
  weight       Float
  assessment   Assessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  clo          CourseLearningOutcome @relation(fields: [cloId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, cloId])
}

model Submission {
  id                String               @id @default(cuid())
  assessmentId      String
  studentId         String
  content           String?
  score             Float?
  feedback          String?
  submittedAt       DateTime             @default(now())
  attachments       String[]             @default([])
  status            String               @default("SUBMITTED")
  answers           StudentAnswer[]
  assessment        Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student           User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cloScores         SubmissionCLOScore[]
  SubmissionHistory SubmissionHistory[]

  @@unique([studentId, assessmentId])
}

model SubmissionCLOScore {
  id           String                @id @default(cuid())
  submissionId String
  cloId        String
  score        Float
  clo          CourseLearningOutcome @relation(fields: [cloId], references: [id], onDelete: Cascade)
  submission   Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, cloId])
}

model AssessmentQuestion {
  id           String                     @id @default(cuid())
  assessmentId String
  text         String
  type         String
  points       Float                      @default(1)
  cloId        String?
  assessment   Assessment                 @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  clo          CourseLearningOutcome?     @relation(fields: [cloId], references: [id])
  options      AssessmentQuestionOption[]
  answers      StudentAnswer[]
}

model AssessmentQuestionOption {
  id         String             @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean            @default(false)
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model StudentAnswer {
  id               String             @id @default(cuid())
  submissionId     String
  questionId       String
  selectedOptionId String?
  textResponse     String?
  points           Float?
  question         AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submission       Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
}

model Feedback {
  id         String   @id @default(cuid())
  userId     String
  targetId   String
  targetType String
  content    String
  rating     Int?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CourseConfig {
  id                    String    @id @default(cuid())
  courseId              String    @unique
  isPublished           Boolean   @default(false)
  enrollmentDeadline    DateTime?
  isSrlEnabled          Boolean   @default(true)
  isGamificationEnabled Boolean   @default(true)
  isForumEnabled        Boolean   @default(true)
  isReflectionsEnabled  Boolean   @default(true)
  isAnalyticsEnabled    Boolean   @default(true)
  difficulty            String?
  course                Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseModule {
  id                       String                 @id @default(cuid())
  courseId                 String
  title                    String
  content                  String?
  weekNumber               Int?
  estimatedDurationMinutes Int?
  cloId                    String?
  createdAt                DateTime               @default(now())
  clo                      CourseLearningOutcome? @relation(fields: [cloId], references: [id])
  course                   Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleClos               CourseModuleCLO[]
}

model CourseModuleCLO {
  id       String                @id @default(cuid())
  moduleId String
  cloId    String
  clo      CourseLearningOutcome @relation(fields: [cloId], references: [id], onDelete: Cascade)
  module   CourseModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, cloId])
}

model SrlReflection {
  id           String     @id @default(cuid())
  enrollmentId String
  weekNumber   Int?
  content      String
  targetMet    Boolean?
  createdAt    DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model ForumThread {
  id         String                 @id @default(cuid())
  courseId   String
  authorId   String
  title      String
  content    String
  cloId      String?
  isResolved Boolean                @default(false)
  createdAt  DateTime               @default(now())
  replies    ForumReply[]
  author     User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  clo        CourseLearningOutcome? @relation(fields: [cloId], references: [id])
  course     Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model ForumReply {
  id           String      @id @default(cuid())
  threadId     String
  authorId     String
  content      String
  isBestAnswer Boolean     @default(false)
  createdAt    DateTime    @default(now())
  author       User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  thread       ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model GamificationProfile {
  id           String     @id @default(cuid())
  enrollmentId String     @unique
  points       Int        @default(0)
  level        Int        @default(1)
  badges       String?
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model StudentSkillAssessment {
  id                      String     @id @default(cuid())
  enrollmentId            String     @unique
  entrepreneurshipScore   Float?
  leadershipScore         Float?
  industryKnowledgeScore  Float?
  employabilitySkillScore Float?
  notes                   String?
  updatedAt               DateTime   @updatedAt
  enrollment              Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model StudentCourseEvaluation {
  id           String     @id @default(cuid())
  enrollmentId String
  type         String
  content      String
  rating       Int?
  createdAt    DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model CurriculumYear {
  id                    String                     @id @default(cuid())
  name                  String
  departmentId          String?
  isActive              Boolean                    @default(false)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  startYear             Int?
  endYear               Int?
  description           String?
  courses               Course[]
  clos                  CourseLearningOutcome[]
  curriculumSubjects    CurriculumSubject[]
  department            Department?                @relation(fields: [departmentId], references: [id])
  departmentCurriculums DepartmentCurriculum[]
  graduateProfiles      GraduateProfile[]
  visionMissions        InstitutionVisionMission[]
  plos                  ProgramLearningOutcome[]

  @@unique([name, departmentId])
}

model CurriculumSubject {
  id                          String         @id @default(cuid())
  curriculumYearId            String
  subjectId                   String
  includeInAnalytics          Boolean        @default(true)
  sclMethod                   String?        @default("NONE")
  isEntrepreneurshipEnabled   Boolean        @default(false)
  isLeadershipEnabled         Boolean        @default(false)
  isIndustrySkillEnabled      Boolean        @default(false)
  isEmployabilitySkillEnabled Boolean        @default(false)
  createdAt                   DateTime       @default(now())
  curriculumYear              CurriculumYear @relation(fields: [curriculumYearId], references: [id], onDelete: Cascade)
  subject                     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([curriculumYearId, subjectId])
}

model DepartmentCurriculum {
  id                    String         @id @default(cuid())
  departmentId          String
  curriculumYearId      String
  status                String         @default("DRAFT")
  submittedAt           DateTime?
  submittedBy           String?
  approvedBy            String?
  approvedAt            DateTime?
  rejectedBy            String?
  rejectedAt            DateTime?
  revisionRequestedAt   DateTime?
  revisionRequestedBy   String?
  revisionRequestNote   String?
  revisionRequestResult String?
  revisionResultAt      DateTime?
  revisionResultBy      String?
  curriculumYear        CurriculumYear @relation(fields: [curriculumYearId], references: [id])
  department            Department     @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, curriculumYearId])
}

model DepartmentHeadHistory {
  id              String     @id @default(cuid())
  departmentId    String
  userId          String
  startYear       Int
  endYear         Int
  appointmentDate DateTime?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GradeScale {
  id           String      @id @default(cuid())
  grade        String
  minScore     Float
  maxScore     Float
  point        Float
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model Announcement {
  id           String      @id @default(cuid())
  title        String
  content      String
  tag          String      @default("Info")
  scope        String      @default("global")
  departmentId String?
  authorId     String
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  author       User        @relation(fields: [authorId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
}

model HelpdeskTicket {
  id           String   @id @default(cuid())
  studentId    String
  subject      String
  message      String
  status       String   @default("OPEN")
  replyMessage String?
  repliedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  replier      User?    @relation("TicketReplier", fields: [repliedById], references: [id])
  student      User     @relation("TicketCreator", fields: [studentId], references: [id], onDelete: Cascade)
}

model TrainingCategory {
  id        String           @id @default(cuid())
  name      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  modules   TrainingModule[]
}

model TrainingModule {
  id          String            @id @default(cuid())
  title       String
  description String
  mediaUrl    String?
  mediaType   String            @default("VIDEO")
  categoryId  String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  category    TrainingCategory? @relation(fields: [categoryId], references: [id])
}

model SubmissionHistory {
  id           String     @id
  submissionId String
  content      String?
  attachments  String[]   @default([])
  feedback     String?
  rejectedAt   DateTime   @default(now())
  Submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}
